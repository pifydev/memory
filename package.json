  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pify",
    "memory"
  ],
  "homepage": "https://github.com/pifydev/memory#readme",
  "bugs": {
    "url": "https://github.com/pifydev/memory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pifydev/memory.git"
  },
  "license": "MIT",
  "author": "Pify maintainers",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/memory.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
